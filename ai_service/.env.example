# ==============================================================================
# Groq API Configuration (Primary LLM Provider)
# ==============================================================================
# Single key:
# GROQ_API_KEY=gsk_your_primary_key_here
#
# Multi-key automatic cascading (supports comma, semicolon, space, or newline):
# When evaluating hundreds of student assignments, supply multiple keys.
# If key 1 hits a rate limit (TPM/RPM), daily token limit, or HTTP 429 quota,
# the service automatically cascades to key 2, key 3, etc. without interrupting
# the batch evaluation.
GROQ_API_KEY=replace_with_groq_api_key_1,replace_with_groq_api_key_2
# Or use GROQ_API_KEYS:
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3

# Assignment evaluation uses native JSON mode with this model.
GROQ_MODEL=openai/gpt-oss-20b

# ==============================================================================
# OpenAI Configuration (Secondary Cloud Provider / Multi-Key Fallback)
# ==============================================================================
# Supports single key or comma-separated keys for automatic cascading:
OPENAI_API_KEY=replace_with_openai_api_key_1,replace_with_openai_api_key_2
# Or use OPENAI_API_KEYS:
# OPENAI_API_KEYS=sk-key1,sk-key2,sk-key3
OPENAI_MODEL=gpt-4o-mini

# ==============================================================================
# Ollama Configuration (Local Zero-Cost Fallback)
# ==============================================================================
# Local zero-cost fallback if all cloud API keys are exhausted.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Whisper model for speech/audio transcription
WHISPER_MODEL=base
