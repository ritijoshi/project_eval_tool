GROQ_API_KEY=replace_with_groq_api_key

# Assignment evaluation uses native JSON mode with this model.
GROQ_MODEL=openai/gpt-oss-20b

# Local zero-cost fallback. Ollama must be running on this machine.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Optional legacy/provider integrations.
OPENAI_API_KEY=replace_with_openai_api_key
WHISPER_MODEL=base
